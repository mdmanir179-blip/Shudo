rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portals collection (direct workspace access)
    match /portals/{portalId} {
      allow read, write: if true;
    }

    // Google Docs and Sheets documents
    match /documents/{documentId} {
      allow read, write: if true;
    }

    // Sheet audit & update logs
    match /sheet_logs/{logId} {
      allow read, write: if true;
    }

    // Orders for analytics and trend cards
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Users / workspace profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
